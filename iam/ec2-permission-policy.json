{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSiteObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::cv-23l-3000/site/*"
    },
    {
      "Sid": "ListOnlySitePrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::cv-23l-3000",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "site/*"
          ]
        }
      }
    }
  ]
}
